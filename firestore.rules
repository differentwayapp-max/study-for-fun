rules_version = '2';

// Study for fun – who can read and write what.
//
// families/{familyId}            familyId = the founding parent's uid (Google sign-in)
//   inviteToken, name            secret inside every kid link · the family's display name
//   /fam/kids                    the list of kids
//   /sets/{setId}                practice sets (questions, chapters …)
//   /progress/{kidId}            a kid's games, trophies, chosen name and picture
//   /devices/{uid}               a kid's phone/tablet (anonymous sign-in) that opened a kid link: { token, kid, at }
//                                kidTokens.{kidId} in the family document = the secret of that kid's link
//   /members/{uid}               another adult in the family: { role: admin | helper | tutor, name, kids[], invite }
//   /invites/{code}              an invitation for one adult: { role, name, kids[], by, exp, used }
//   /tutorView/{code}            what a tutor may see of the family: { famName, kids: [{id, name, grade, color}] } – only the
//                                tutor's own kids; keyed by the tutor's invitation code (written with the invitation, kept up to
//                                date by the parent's app), read only by the tutor who joined with that code
// users/{uid}                    { fams: [familyId…] } – the families an adult belongs to (written by that adult)
//   families/{f}/usage/{YYYY-MM}  { builds, light } · billing/main { credits } · builds/{id}  – server only
// families/{classId}             a teacher's group: kind 'class', ownerUid = the teacher, a random 20-character id (never a
//                                uid – those are 28), made only by the server (createClass: at most 10 a teacher); kind and
//                                ownerUid never change. No other adults (no invitations).
//   /consents/{kid}              a parent's consent (signed in the app, approved by the teacher – the only way a student joins)
//                                – a kid phone joins a group only with one; server only
//   /joinReqs/{id}, /joinLink/main   parents' requests and the group's link – the teacher reads them; server only
//   /kidpub/{kid}                the one student a student's phone may read (instead of fam/kids); fam/info – the group's name
//   A student's phone in a group reads only its own student, progress and practice sets – never the other students.
// teachers/{uid}                 { classes: [...] } – the server's count of a teacher's groups (read by that teacher)
// meta/ai_spend_{YYYY-MM}        estimated AI spend this month (server only) · meta/ai_day_{date} (daily cap)
//
// Link secrets: families/{f}.kidTokens (a kid's link), .inviteToken (old family-wide link – no longer joins a phone),
// devices/{uid}.token (the same kid token), invites/{code} (the code is the secret). Only the founding parent, admins
// and helpers read them; a tutor never; the invitations list only the parent and admins.
//
// Founding parent and admins: everything in the family.
// Helpers: read everything in the family, add and change practice sets, write progress.
// Tutors: only the kids in their members/{uid}.kids – those kids' practice sets and progress, and their tutorView.
//         Never the family document (kid link secrets), the kids list, devices, invitations or other adults.
// Kid device: joins once with its kid's link token, reads the family's practice sets, writes only that kid's progress.
//             (phones that joined before per-kid links have no `kid` and keep their old access)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // a parent: Google, or an email sign-in link (its address is verified by the link). An email+password account whose
    // address was never verified is not a parent (Email/Password with links only – no one can borrow someone else's address)
    function google() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
      && (request.auth.token.firebase.sign_in_provider == 'google.com' || request.auth.token.email_verified == true); }
    function famPath(f) { return /databases/$(database)/documents/families/$(f); }
    function famDoc(f) { return get(famPath(f)).data; }
    function isClass(f) { return famDoc(f).get('kind', '') == 'class'; }
    // the founding parent (the family id is the parent's uid) – or the teacher of a group (ownerUid; groups only)
    function isOwner(f) { return google() && (request.auth.uid == f || (isClass(f) && famDoc(f).ownerUid == request.auth.uid)); }
    function isMember(f) { return google() && exists(/databases/$(database)/documents/families/$(f)/members/$(request.auth.uid)); }
    function memberRole(f) { return get(/databases/$(database)/documents/families/$(f)/members/$(request.auth.uid)).data.role; }
    function isAdmin(f) { return isOwner(f) || (isMember(f) && memberRole(f) == 'admin'); }
    function isAdult(f) { return isOwner(f) || isMember(f); }
    // a tutor sees only the kids of the invitation; everyone else among the adults sees the whole family
    function isTutor(f) { return isMember(f) && memberRole(f) == 'tutor'; }
    function isFull(f) { return isOwner(f) || (isMember(f) && memberRole(f) != 'tutor'); }
    function tutorKids(f) { return get(/databases/$(database)/documents/families/$(f)/members/$(request.auth.uid)).data.get('kids', []); }
    function tutorHas(f, kid) { return isTutor(f) && kid is string && kid in tutorKids(f); }
    function setKid(d) { return d.get('set', {}).get('kidId', null); }
    // a group's assignment: one shared set for 'all' its students or a list of them – no kid's id or name in it
    function setTo(d) { return d.get('set', {}).get('to', null); }
    // a phone asks exactly this (to == 'all', or toMap.<its kid> == true) – a list query is allowed only when the rule can be proved from it
    function setForKid(d, kid) { return kid is string && (setTo(d) == 'all' || d.get('set', {}).get('toMap', {}).get(kid, false) == true); }
    function sharedOk(d) { return !('to' in d.get('set', {})) || (!('kidId' in d.set) && !('name' in d.set)
      && (d.set.to == 'all' || (d.set.to is list && d.set.to.size() <= 40 && d.set.get('toMap', {}).keys().hasOnly(d.set.to)))); }
    function consented(f, kid) { return kid is string
      && get(/databases/$(database)/documents/families/$(f)/consents/$(kid)).data.status == 'digital'; }
    function isDevice(f) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(f)/devices/$(request.auth.uid));
    }
    // the kid a device belongs to (null: a phone that joined before per-kid links)
    function deviceKid(f) { return get(/databases/$(database)/documents/families/$(f)/devices/$(request.auth.uid)).data.get('kid', null); }
    function kidToken(f, kid) { return get(famPath(f)).data.get('kidTokens', {}).get(kid, null); }
    function invitePath(f, code) { return /databases/$(database)/documents/families/$(f)/invites/$(code); }

    // app admins (by Google account email) – review catalog suggestions, publish to the catalog
    // an app admin: a Google account with one of these addresses, and the address must be verified
    function appAdmin() { return google() && request.auth.token.email_verified == true && request.auth.token.email in ['differentway.app@gmail.com', 'taliahblass@gmail.com']; }
    // documents other users create may only have Firestore's own random ids (no quotes or markup smuggled in through the id)
    function autoId(id) { return id.matches('^[A-Za-z0-9]{20}$'); }
    function str(v, n) { return v is string && v.size() <= n; }

    // the in-app catalog: every signed-in user reads it; only admins publish
    match /catalog/{id} { allow read: if signedIn(); allow write: if appAdmin(); }
    match /catalogCode/{id} { allow read: if signedIn(); allow write: if appAdmin(); }
    // a parent offers a practice set; only admins read and handle the suggestions
    // settings only the app admins see (where bug reports are emailed); the server reads it with admin rights
    match /adminConfig/{id} {
      allow read, write: if appAdmin();
    }

    // bug reports / ideas from any signed-in user (parents and kid phones); only the app admins read them
    match /bugReports/{id} {
      // a random id, typed and sized fields, and at most one report a minute per user (written together with bugLimits/{uid})
      allow create: if signedIn() && autoId(id)
        && request.resource.data.keys().hasOnly(['by','byName','at','kind','text','where','ver','ua','role'])
        && request.resource.data.by == request.auth.uid
        && str(request.resource.data.text, 3000) && request.resource.data.kind in ['bug','idea','q']
        && str(request.resource.data.byName, 60) && str(request.resource.data.where, 120) && str(request.resource.data.ver, 30)
        && str(request.resource.data.ua, 300) && str(request.resource.data.role, 20) && request.resource.data.at is number
        && getAfter(/databases/$(database)/documents/bugLimits/$(request.auth.uid)).data.at == request.time;
      allow read, delete: if appAdmin();
    }
    // the server log (written only by the server): app admins read and clear it
    match /serverLog/{id} { allow read, delete: if appAdmin(); }
    match /bugLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && request.time > resource.data.at + duration.value(1, 'm');
    }

    match /catalogSuggestions/{id} {
      allow create: if google() && autoId(id) && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by','byName','at','subject','grade','topics','chapters','questions','code'])
        && str(request.resource.data.byName, 60) && str(request.resource.data.subject, 60)
        && request.resource.data.grade is int && request.resource.data.grade >= 0 && request.resource.data.grade <= 11
        && request.resource.data.chapters is int && request.resource.data.questions is int
        && request.resource.data.topics is list && request.resource.data.topics.size() <= 30
        && request.resource.data.at is number
        && request.resource.data.code is string && request.resource.data.code.size() < 900000;
      allow read, update, delete: if appAdmin();
    }

    match /teachers/{uid} { allow read: if google() && request.auth.uid == uid; allow write: if false;
      // a teacher's AI quota (all their groups together) – the server writes it, the teacher reads it
      match /usage/{month} { allow read: if google() && request.auth.uid == uid; allow write: if false; }
    }

    match /users/{uid} {
      allow read, write: if google() && request.auth.uid == uid;
    }

    match /families/{familyId} {
      allow read: if isFull(familyId);                 // the family document holds the kid link secrets
      // a family: only by its own parent, never with kind/ownerUid (a group is made by the server only)
      allow create: if isOwner(familyId) && !('kind' in request.resource.data) && !('ownerUid' in request.resource.data);
      allow delete: if isOwner(familyId);
      allow update: if isAdmin(familyId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kind', 'ownerUid']);

      match /devices/{uid} {
        allow read: if isFull(familyId) || (signedIn() && request.auth.uid == uid);
        // join (or move the phone to another kid of the family) only with that kid's link token
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && (!isClass(familyId) || consented(familyId, request.resource.data.kid))   // a group: only with a parent's consent
          && request.resource.data.keys().hasOnly(['token', 'kid', 'at'])
          && request.resource.data.kid is string
          && request.resource.data.token is string
          && request.resource.data.token == kidToken(familyId, request.resource.data.kid);
        allow delete: if isAdmin(familyId);
      }

      match /fam/{docId} {
        // a group: a student's phone reads only the group's name (fam/info), never the students (fam/kids); the server writes both
        allow read: if isFull(familyId) || (isDevice(familyId) && (!isClass(familyId) || docId == 'info'));
        allow write: if isAdmin(familyId) && !isClass(familyId);
      }
      match /kidpub/{kidId} {
        allow read: if isFull(familyId) || (isDevice(familyId) && deviceKid(familyId) == kidId);
        allow write: if false;
      }
      match /consents/{kidId} { allow read: if isAdmin(familyId); allow write: if false; }
      match /joinReqs/{id} { allow read: if isAdmin(familyId); allow write: if false; }
      match /joinLink/{id} { allow read: if isAdmin(familyId); allow write: if false; }
      // a group's teacher's private notes on a student (nobody else: no student phone, no parent)
      match /notes/{kidId} { allow read, delete: if isClass(familyId) && isOwner(familyId);
        allow create, update: if isClass(familyId) && isOwner(familyId) && request.resource.data.keys().hasOnly(['text','at'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000 && request.resource.data.at is number; }
      // a private group's fixed lessons and "the parents' update was sent" – the teacher only (as the notes)
      match /sched/{kidId} { allow read, delete: if isClass(familyId) && isOwner(familyId);
        allow create, update: if isClass(familyId) && isOwner(familyId) && request.resource.data.keys().hasOnly(['slots','from','last','upd'])
          && request.resource.data.slots is list && request.resource.data.slots.size() <= 7
          && request.resource.data.from is number && request.resource.data.last is number && request.resource.data.upd is number; }

      // a tutor's own small view of the family (see the top)
      match /tutorView/{code} {
        allow read: if isFull(familyId)
          || (isTutor(familyId) && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.invite == code);
        allow write: if isAdmin(familyId);
      }

      // a tutor: only practice sets of the tutor's kids, and never moved to another kid (old and new kid both the tutor's)
      // (a tutor's query must ask for those kids only – rules don't filter)
      match /sets/{setId} {
        // a group's student phone: its own student's sets, and the assignments given to all or to that student
        allow read: if isFull(familyId) || tutorHas(familyId, setKid(resource.data))
          || (isDevice(familyId) && (!isClass(familyId) || setKid(resource.data) == deviceKid(familyId) || setForKid(resource.data, deviceKid(familyId))));
        allow create: if (isFull(familyId) && sharedOk(request.resource.data)) || tutorHas(familyId, setKid(request.resource.data));
        allow update: if (isFull(familyId) && sharedOk(request.resource.data)) || (tutorHas(familyId, setKid(resource.data)) && tutorHas(familyId, setKid(request.resource.data)));
        allow delete: if isAdmin(familyId);
      }

      match /progress/{kidId} {
        allow read: if isFull(familyId) || tutorHas(familyId, kidId)
          || (isDevice(familyId) && (!isClass(familyId) || deviceKid(familyId) == kidId));                   // a group: its own only
        allow write: if (isFull(familyId) || tutorHas(familyId, kidId) || (isDevice(familyId) && deviceKid(familyId) in [null, kidId]))
          && request.resource.data.keys().hasOnly(['history', 'profile']);
        allow delete: if isAdmin(familyId);
      }

      // other adults of the family
      match /members/{uid} {
        allow read: if isFull(familyId) || (google() && request.auth.uid == uid);
        // joining: only yourself, only with a valid, unused invitation, with exactly the role and kids it gives,
        // and in the same write that marks the invitation used (so one invitation = one adult)
        allow create: if google() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'name', 'kids', 'invite', 'at'])
          && request.resource.data.invite is string
          && exists(invitePath(familyId, request.resource.data.invite))
          && get(invitePath(familyId, request.resource.data.invite)).data.used == false
          && get(invitePath(familyId, request.resource.data.invite)).data.exp > request.time.toMillis()
          && request.resource.data.role == get(invitePath(familyId, request.resource.data.invite)).data.role
          && request.resource.data.kids == get(invitePath(familyId, request.resource.data.invite)).data.kids
          && getAfter(invitePath(familyId, request.resource.data.invite)).data.used == true
          && getAfter(invitePath(familyId, request.resource.data.invite)).data.usedBy == request.auth.uid;
        allow update: if isAdmin(familyId);
        allow delete: if isAdmin(familyId) || (google() && request.auth.uid == uid);   // remove someone · leave
      }

      // monthly quota and paid credits – written only by the server (Cloud Functions), read by the family's adults
      match /usage/{month} { allow read: if isAdult(familyId); allow write: if false; }
      match /billing/{doc} { allow read: if isAdult(familyId); allow write: if false; }
      // a build: the parent and the helpers; a tutor sees only the builds it started (its own build screen)
      match /builds/{id} { allow read: if isFull(familyId) || (isTutor(familyId) && resource.data.by == request.auth.uid); allow write: if false; }
      // failure log (what failed and why – no prompt text): adults add entries and read them; a kid's phone adds
      // entries too (a sound check on the kid's own phone), but cannot read them
      match /errlog/{id} {
        allow read: if isFull(familyId);
        allow create: if (isAdult(familyId) || isDevice(familyId)) && request.resource.data.keys().hasOnly(['at','where','code','msg','subject','ver','by'])
          && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
          && str(request.resource.data.get('by', ''), 60) && str(request.resource.data.get('where', ''), 40);
        allow update: if false;
        allow delete: if isAdmin(familyId);   // account deletion
      }

      match /invites/{code} {
        allow create: if isAdmin(familyId) && !isClass(familyId);   // a group has no other adults (not in the first version)
        allow delete: if isAdmin(familyId);
        allow get: if google();                     // the code itself is the secret: open one by its code…
        allow list: if isAdmin(familyId);           // …but only the parent and admins list them (a family id is in every kid link)
        // the invited adult marks it used (once), together with joining
        allow update: if google() && resource.data.used == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy'])
          && request.resource.data.used == true && request.resource.data.usedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.invite == code;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
